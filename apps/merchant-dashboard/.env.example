VITE_API_BASE_URL=/api/v1
# Storefront app origin; the website and funnel editors post live previews to it.
VITE_STOREFRONT_URL=http://localhost:3000
# Root domain stores are served on; the dashboard builds each store link as <slug>.<this>.
VITE_PUBLIC_ROOT_DOMAIN=zimos.co

# Error reporting (packages/error-reporter): empty = errors stay in the console.
VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_RELEASE=
