NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Server-only: no NEXT_PUBLIC_ prefix, so it never reaches the browser. Same
# value as the API's STOREFRONT_PROXY_SECRET; lets server-rendered pages pass
# each shopper's IP to the API's rate limiter.
STOREFRONT_PROXY_SECRET=

# Root domain each store's subdomain hangs off: `<slug>.zimos.co`. Also decides
# where a request with no store in its host is redirected. Override for a
# staging domain; leave unset to use the production default.
NEXT_PUBLIC_ROOT_DOMAIN=zimos.co
